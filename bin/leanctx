#!/usr/bin/env node
/**
 * LeanCTX CLI - Cache management only
 */

const { clearCache } = require('../dist/index.js');

const args = process.argv.slice(2);
const action = args[0];

switch (action) {
  case 'clear':
  case 'clear-cache':
    clearCache();
    console.log('Cache cleared');
    break;
  default:
    console.log('Usage: leanctx clear-cache');
    console.log('');
    console.log('  clear-cache  Clear the compression cache');
    process.exit(1);
}
